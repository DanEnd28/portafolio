# Copia este archivo a ".env" y rellena los valores que necesites.

# Webhook de n8n al que el FORMULARIO de contacto envía los mensajes.
# Si se deja vacío, el formulario abre el cliente de correo como respaldo.
VITE_N8N_WEBHOOK_URL=

# Webhook de n8n del ASISTENTE de chat (widget flotante).
# Si se deja vacío, el widget de chat no aparece.
VITE_N8N_CHAT_WEBHOOK_URL=

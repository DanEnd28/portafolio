# Copia este archivo a ".env.local" y rellena los valores que necesites.
# En Vercel: Settings → Environment Variables (y luego Redeploy).
# Las NEXT_PUBLIC_* se incrustan al compilar: si las cambias, hay que volver a desplegar.

# Webhook de n8n al que el FORMULARIO de contacto envía los mensajes
# (workflow n8n/contacto/contacto-portafolio.json).
# Si se deja vacío, el formulario abre el cliente de correo como respaldo.
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Webhook de n8n del ASISTENTE de chat (widget flotante)
# (workflow n8n/asistente-chat/asistente-danny.json).
# Si se deja vacío, el widget de chat no aparece.
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=

# (Opcional) URL pública del sitio, para las etiquetas OpenGraph y hreflang.
# Ej: https://dannyendara.vercel.app — si se deja vacío, en Vercel se usa el dominio de producción.
NEXT_PUBLIC_SITE_URL=
